<IfModule mod_rewrite.c>
    RewriteEngine On

    # 301 redirect: external *.php requests -> extensionless URLs (preserve query string)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+([^\s?]*/)index\.php(\S*)\s [NC]
    RewriteRule ^ /%1%2 [R=301,L,NE]

    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+index\.php(\S*)\s [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.php(\S*)\s [NC]
    RewriteRule ^ /%1%2 [R=301,L,NE]

    # Serve real files and directories (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Extensionless URL -> matching .php script when it exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

DirectoryIndex index.php

# Raise upload limits when Apache runs PHP as mod_php (ignored under PHP-FPM).
# For PHP-FPM / nginx, set the same values in php.ini / pool config and nginx client_max_body_size.
<IfModule mod_php.c>
    php_value upload_max_filesize 200M
    php_value post_max_size 220M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 200M
    php_value post_max_size 220M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 200M
    php_value post_max_size 220M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 512M
</IfModule>

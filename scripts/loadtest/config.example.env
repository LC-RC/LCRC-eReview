# Copy to config.local.env and edit. Never point at production.

EREVIEW_LOADTEST=1
EREVIEW_LOADTEST_CONFIRM=YES

# REQUIRED — must be exactly one of: ereview_loadtest | ereview_test
LOADTEST_DB_NAME=ereview_loadtest

# Optional if db.local.php host/user/pass should be reused (connection still uses LOADTEST_DB_NAME only)
# LOADTEST_DB_HOST=127.0.0.1
# LOADTEST_DB_USER=root
# LOADTEST_DB_PASS=

# REQUIRED — no silent default. Must be the isolated load-test / staging web base URL.
# Example only (uncomment and set for your staging instance):
# LOADTEST_BASE_URL=http://127.0.0.1/EreviewLoadtest

# Run sizing
LOADTEST_N=5
LOADTEST_QUESTION_COUNT=50
LOADTEST_TIME_LIMIT_SECONDS=180
LOADTEST_ALIGN_SECONDS=90

# Optional: absolute T_end (MySQL datetime, Asia/Manila / +08:00 session)
# LOADTEST_T_END=2026-08-20 18:00:00

# Deterministic answer secret (keep stable for a run)
LOADTEST_ANSWER_SECRET=loadtest-phase-a-secret

# Session isolation: defaults to scripts/loadtest/sessions (recommended).
# Do NOT point at shared C:\xampp\tmp. Apache/staging must use the same path for SAFE.
# LOADTEST_SESSION_SAVE_PATH=

# LOADTEST_HTTP_START is rejected — attempts start via CLI on the guarded DB only.
# Operator flags alone never yield SAFE; HttpPreflight must prove runtime DB via probe.

# k6 scenario knobs
LOADTEST_AUTOSAVE_FAILURE_RATE=0.20
LOADTEST_DUPLICATE_SUBMIT_RATE=0.15
LOADTEST_ANSWER_RATE=1.0
LOADTEST_GRACE_SECONDS=60

# Monitor poller
LOADTEST_MONITOR_SECONDS=120
LOADTEST_MONITOR_INTERVAL_MS=3000

# Teardown requires EXTRA confirmation
# LOADTEST_TEARDOWN_CONFIRM=YES
